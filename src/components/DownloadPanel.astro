---
import type { ReleaseManifest, PlatformDownloads } from '../types/release';
import { fetchReleaseManifest, parseDownloads, formatReleaseDate } from '../utils/release';

// Fetch release data at build time
const manifestUrl = import.meta.env.PUBLIC_RELEASES_MANIFEST_URL;
const manifest: ReleaseManifest | null = await fetchReleaseManifest(manifestUrl);

let downloads: {
  windows: PlatformDownloads;
  macos: PlatformDownloads;
  linux: PlatformDownloads;
} | null = null;

if (manifest) {
  downloads = parseDownloads(manifest);
}
---

<section class="min-h-screen flex items-center pt-16 bg-gradient-to-br from-base-100 via-purple-50/20 to-base-100 dark:from-base-100 dark:via-purple-900/10 dark:to-base-100">
  <div class="container mx-auto px-4 py-16">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold mb-6">
        Download{' '}
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-violet-500">
          LifeVault
        </span>
      </h1>
      <p class="text-lg text-base-content/70 max-w-2xl mx-auto mb-6">
        Choose your platform and start organizing your digital life today. 
        LifeVault is free to download and use.
      </p>
      
      {manifest && (
        <div class="flex flex-wrap gap-3 justify-center items-center">
          <div class="badge badge-lg badge-primary">
            Latest version: {manifest.version}
          </div>
          <div class="badge badge-lg badge-outline">
            Released: {formatReleaseDate(manifest.publishedAt)}
          </div>
        </div>
      )}
    </div>

    {!manifest ? (
      <!-- Fallback UI when fetch fails -->
      <div class="max-w-2xl mx-auto">
        <div class="alert alert-warning shadow-lg">
