<!-- Embed versions data fetched at build time -->
<div id="versions-data" data-versions={JSON.stringify(versionsData)} style="display:none;"></div>

<!-- Client-side OS detection and reordering -->
<script>
  type OSType = 'windows' | 'macos' | 'linux' | 'unknown';

  /**
   * Detect the visitor's operating system from user agent
   * Maps common user agent patterns to our OS types
   */
  function detectOS(): OSType {
    if (typeof navigator === 'undefined') return 'unknown';
    
    const userAgent = navigator.userAgent.toLowerCase();
    
    // Check for Windows
    if (userAgent.includes('win')) return 'windows';
    // Check for macOS (includes Mac, iPhone, iPad)
    if (userAgent.includes('mac')) return 'macos';
    // Check for Linux (but exclude Android)
    if ((userAgent.includes('linux') || userAgent.includes('x11')) && !userAgent.includes('android')) {
      return 'linux';
    }
    
    return 'unknown';
  }

  /**
   * Reorder download sections to prioritize the detected OS
   * Progressive enhancement: without JS, default order is maintained
   */
  function reorderPlatforms() {
    const detectedOS = detectOS();
    
    // If OS is unknown, keep default order
    if (detectedOS === 'unknown') return;
    
    const container = document.getElementById('download-panel');
    if (!container) return;
    
    // Find all download sections
    const sections = Array.from(container.querySelectorAll('.download-section')) as HTMLElement[];
    if (sections.length === 0) return;
    
    // Find the section matching the detected OS
    const detectedSection = sections.find(section => section.dataset.os === detectedOS);
    
    // If detected OS section doesn't exist or has no downloads, keep default order
    if (!detectedSection) return;
    
    // Show the "Recommended for you" badge on the detected OS
    const badge = detectedSection.querySelector('.recommended-badge');
    if (badge) {
      badge.classList.remove('hidden');
    }
    
    // Define the default order for remaining platforms
    const defaultOrder: OSType[] = ['windows', 'macos', 'linux'];
    
    // Create new order: detected OS first, then others in default order
    const newOrder = [
      detectedOS,
      ...defaultOrder.filter(os => os !== detectedOS)
    ];
    
    // Reorder sections in the DOM to match visual order (accessibility requirement)
    // This ensures screen readers and keyboard navigation follow the visual priority
    newOrder.forEach((os) => {
      const section = sections.find(s => s.dataset.os === os);
      if (section) {
        container.appendChild(section);
      }
    });
  }

  // Run on page load - hydration-safe (only runs client-side)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', reorderPlatforms);
  } else {
    reorderPlatforms();
  }

  // Client-side update check for latest version and available versions
  async function checkForUpdates() {
    const manifestUrl = 'https://downloads.lifevault.sabrlabs.co.uk/latest.json';
    
    try {
      const response = await fetch(manifestUrl, {
        cache: 'no-cache',
        headers: {
          'Accept': 'application/json',
        }
      });
      
      if (!response.ok) {
        console.debug('Could not fetch latest release manifest');
        return;
      }
      
      const freshManifest = await response.json();
      
      const versionText = document.getElementById('selected-version');
      if (!versionText) return;
      
      const currentVersion = versionText.textContent?.replace('Latest version: ', '').trim();
      const latestVersion = freshManifest.version;
      
      if (currentVersion !== latestVersion) {
        console.log('New version available:', latestVersion, '(current:', currentVersion + ')');
        versionText.textContent = 'Latest version: ' + latestVersion;
      } else {
        console.debug('Page is up to date with latest version:', currentVersion);
      }
      
      const dateBadge = document.getElementById('release-date');
      if (dateBadge && freshManifest.publishedAt) {
        const date = new Date(freshManifest.publishedAt);
        const formatted = date.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        });
        dateBadge.textContent = 'Released: ' + formatted;
      }
      
      updateDownloadUrls(freshManifest);
      
    } catch (error) {
      console.debug('Error checking for updates:', error);
    }
  }
  
  let availableVersionsIndex = {};

  function loadAvailableVersions() {
    const dataEl = document.getElementById('versions-data');
    let versions: any[] = [];
    try {
      versions = JSON.parse(dataEl?.getAttribute('data-versions') || '[]');
    } catch (e) {
      console.debug('Could not parse versions data');
    }
    
    if (versions.length === 0) {
      console.debug('No versions data available');
      return;
    }
    
    // Determine the latest version: first entry in the array, or fall back to what's shown in the UI
    let latestVersion = versions[0]?.version || null;
    if (!latestVersion) {
      const versionText = document.getElementById('selected-version');
      latestVersion = versionText?.textContent?.replace('Latest version: ', '').replace('Version: ', '').trim() || '';
    }
    
    populateVersionDropdown(versions, latestVersion);
  }
  
  function populateVersionDropdown(versions, latestVersion) {
    const dropdown = document.getElementById('version-dropdown');
    if (!dropdown) return;
    
    dropdown.innerHTML = '';

    availableVersionsIndex = versions.reduce(function(acc, item) {
      if (item?.version) {
        acc[item.version] = item;
      }
      return acc;
    }, {});

    versions.forEach(function(item) {
      const version = item?.version;
      if (!version) return;
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.setAttribute('data-version', version);
      a.textContent = version + (version === latestVersion ? ' (Latest)' : '');
      if (version === latestVersion) {
        a.className = 'active';
      }
      
      a.addEventListener('click', function(e) {
        e.preventDefault();
        // Close the dropdown
        const details = document.getElementById('version-dropdown-details');
        if (details) details.removeAttribute('open');
        switchVersion(version);
      });
      
      li.appendChild(a);
      dropdown.appendChild(li);
    });
  }
  
  async function switchVersion(version) {
    const versionText = document.getElementById('selected-version');
    if (versionText) {
      versionText.textContent = 'Version: ' + version;
    }
    
    const dropdownItems = document.querySelectorAll('#version-dropdown a');
    dropdownItems.forEach(function(item) {
      if (item.getAttribute('data-version') === version) {
        item.classList.add('active');
      } else {
        item.classList.remove('active');
      }
    });
    
    try {
      const versionManifest = availableVersionsIndex[version];
      if (!versionManifest) {
        console.warn('No version metadata available for', version);
        return;
      }

      const dateBadge = document.getElementById('release-date');
      if (dateBadge) {
        if (versionManifest.publishedAt) {
          const date = new Date(versionManifest.publishedAt);
          const formatted = date.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          });
          dateBadge.textContent = 'Released: ' + formatted;
        } else {
          dateBadge.textContent = 'Released: —';
        }
      }
      
      updateDownloadUrls(versionManifest);
      showVersionChangeNotification(version);
      
    } catch (error) {
      console.error('Error switching version:', error);
    }
  }
  
  function showVersionChangeNotification(version) {
    const toast = document.createElement('div');
    toast.className = 'alert alert-info shadow-lg fixed bottom-4 right-4 w-auto max-w-sm z-50 animate-fade-in';
    toast.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg><span>Switched to version ' + version + '</span>';
    
    document.body.appendChild(toast);
    
    setTimeout(function() {
      toast.style.opacity = '0';
      toast.style.transition = 'opacity 0.3s ease-out';
      setTimeout(function() { toast.remove(); }, 300);
    }, 3000);
  }
  
  function updateDownloadUrls(manifest) {
    const baseUrl = manifest.baseUrl;
    const paths = manifest.paths;
    
    const buildUrl = function(path) {
      if (!path) return '';
      const base = baseUrl.endsWith('/') ? baseUrl.slice(0, -1) : baseUrl;
      const relative = path.startsWith('/') ? path.slice(1) : path;
      return base + '/' + relative;
    };
    
    if (paths.windows) {
      updateSectionUrls('windows', {
        primary: paths.windows.installerExe,
        msi: paths.windows.msi,
        portable: paths.windows.portableExe
      }, buildUrl);
    }
    
    if (paths.macos) {
      updateSectionUrls('macos', {
        primary: paths.macos.dmg,
        zip: paths.macos.zip
      }, buildUrl);
    }
    
    if (paths.linux) {
      updateSectionUrls('linux', {
        primary: paths.linux.appImage,
        deb: paths.linux.deb
      }, buildUrl);
    }
  }
  
  function updateSectionUrls(os, paths, buildUrl) {
    const section = document.querySelector('[data-os="' + os + '"]');
    if (!section) return;
    
    // Update primary download card
    if (paths.primary) {
      const primaryCard = section.querySelector('.card.border-primary\\/20');
      if (primaryCard) {
        const primaryBtn = primaryCard.querySelector('.btn-primary');
        if (primaryBtn) {
          primaryBtn.setAttribute('href', buildUrl(paths.primary));
        }
        // Update visible file name
        const fileNameSpan = primaryCard.querySelector('.text-xs.text-base-content\\/50');
        if (fileNameSpan) {
          fileNameSpan.textContent = paths.primary.split('/').pop() || paths.primary;
        }
      }
    }
    
    // Update alternative download cards
    const altCards = section.querySelectorAll('.card.border-base-300');
    let altIndex = 0;
    
    Object.keys(paths).forEach(function(key) {
      if (key !== 'primary' && paths[key]) {
        const card = altCards[altIndex];
        if (card) {
          const btn = card.querySelector('.btn-outline');
          if (btn) {
            btn.setAttribute('href', buildUrl(paths[key]));
          }
        }
        altIndex++;
      }
    });
  }
  
  function showUpdateNotification() {
    const toast = document.createElement('div');
    toast.className = 'alert alert-success shadow-lg fixed bottom-4 right-4 w-auto max-w-sm z-50 animate-fade-in';
    toast.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg><span>Download links updated to latest version</span>';
    
    document.body.appendChild(toast);
    
    setTimeout(function() {
      toast.style.opacity = '0';
      toast.style.transition = 'opacity 0.3s ease-out';
      setTimeout(function() { toast.remove(); }, 300);
    }, 4000);
  }
  
  function initDownloadPanel() {
    checkForUpdates();
    // Versions data is embedded at build time - no fetch needed
    loadAvailableVersions();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      setTimeout(initDownloadPanel, 500);
    });
  } else {
    setTimeout(initDownloadPanel, 500);
  }
</script>

<style>
  .download-section {
    scroll-margin-top: 6rem;
  }
  
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-fade-in {
    animation: fade-in 0.3s ease-out;
  }
</style>