---
import type { ReleaseManifest, PlatformDownloads } from '../types/release';
import { fetchReleaseManifest, parseDownloads, formatReleaseDate } from '../utils/release';

// Fetch release data at build time
const manifestUrl = import.meta.env.PUBLIC_RELEASES_MANIFEST_URL;
const manifest: ReleaseManifest | null = await fetchReleaseManifest(manifestUrl);

let downloads: {
  windows: PlatformDownloads;
  macos: PlatformDownloads;
  linux: PlatformDownloads;
} | null = null;

if (manifest) {
  downloads = parseDownloads(manifest);
}

// Fetch versions list at build time (avoids CORS issues with client-side fetch)
let versionsData: any[] = [];
try {
  const versionsRes = await fetch('https://downloads.lifevault.sabrlabs.co.uk/versions.json');
  if (versionsRes.ok) {
    const versionsJson = await versionsRes.json();
    versionsData = Array.isArray(versionsJson?.versions) ? versionsJson.versions : [];
  }
} catch (e) {
  // versions.json not available at build time - dropdown will only show current version
}
