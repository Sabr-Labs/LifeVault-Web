---
import Navbar from "../components/Navbar";
import Footer from "../components/Footer";

interface Props {
  title?: string;
  hideFooter?: boolean;
}

const { title = "LifeVault - Organize Your Digital Life", hideFooter = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Favicon configuration: LifeVault branded icons -->
    <!-- ICO favicon (LifeVault transparent logo, 256x256) -->
    <link rel="icon" href="/favicon.ico" />
    <!-- Apple Touch Icon for iOS home screen and Safari pinned tabs (192x192) -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="LifeVault - A file-system-first organizer that turns your existing cloud/local storage into a structured vault for IDs, warranties, receipts, and important documents."
    />
    <title>{title}</title>
    <script is:inline>
      // Initialize theme before page renders to prevent flash
      (function () {
        const savedTheme = localStorage.getItem("theme");
        const systemPrefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        const theme = savedTheme || (systemPrefersDark ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-base-100">
    <Navbar client:load />
    <main class="flex-1">
      <slot />
    </main>
    {!hideFooter && <Footer client:load />}
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
</style>
