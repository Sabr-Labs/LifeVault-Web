---
import Navbar from '../components/Navbar';
import Footer from '../components/Footer';

interface Props {
  title?: string;
}

const { title = 'LifeVault - Organize Your Digital Life' } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="LifeVault - A file-system-first organizer that turns your existing cloud/local storage into a structured vault for IDs, warranties, receipts, and important documents." />
		<title>{title}</title>
	</head>
	<body class="min-h-screen flex flex-col bg-base-100">
		<Navbar client:load />
		<main class="flex-1">
			<slot />
		</main>
		<Footer client:load />
	</body>
</html>

<style is:global>
	html {
		scroll-behavior: smooth;
	}
</style>
